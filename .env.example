# ─── Supabase (production / hosted) ──────────────────────────────────
# Used by the Next.js app at runtime and by data/scripts/seed.ts when
# SUPABASE_SERVICE_ROLE_KEY is also present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, NEVER ship to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Direct Postgres (local dev / seed without Supabase API) ─────────
# Used by data/scripts/seed.ts when SEED_VIA=pg or when no Supabase
# service role key is available. The schema in supabase/migrations is
# Supabase-compatible; this just bypasses PostgREST for bulk inserts.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/bc_clinic_atlas

# ─── Geocoder ────────────────────────────────────────────────────────
# Nominatim usage policy requires a descriptive User-Agent with contact info.
NOMINATIM_USER_AGENT=BCClinicAtlas/0.1 (seed; contact: you@example.com)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Force the seed path: "supabase" | "pg" (default: auto)
# SEED_VIA=
