{
  "name": "bc-clinic-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "dotenv -e .env.local -e .env -- bash -c 'psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -c \"drop schema if exists public cascade; create schema public; grant usage on schema public to anon, authenticated, service_role;\"' && pnpm db:migrate",
    "db:migrate": "dotenv -e .env.local -e .env -- bash -c 'for f in supabase/migrations/*.sql; do echo \"▸ $f\"; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done'",
    "db:seed": "dotenv -e .env.local -e .env -- tsx data/scripts/seed.ts",
    "db:types": "dotenv -e .env.local -e .env -- bash -c 'supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public > lib/supabase/types.generated.ts'"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.15",
    "pmtiles": "^4.4.1",
    "react": "19",
    "react-dom": "19",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "pg": "^8.20.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
